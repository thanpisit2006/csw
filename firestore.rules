rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAdmin() {
      return request.auth != null;
    }

    // Students collection (Student ID validation)
    match /students/{studentId} {
      allow read: if true;
      allow create: if request.resource.data.studentId.matches('^6807050[0-9]{4}$');
      allow update: if isAdmin() || (resource.data.studentId == request.resource.data.studentId);
      allow delete: if isAdmin();
    }

    // Sessions collection
    match /sessions/{sessionId} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Audit logs collection (Immutable trail)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // Downloads collection
    match /downloads/{downloadId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Announcements collection
    match /announcements/{annId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Schedules collection (Manageable ONLY by Admin)
    match /schedules/{scheduleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
