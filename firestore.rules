rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAdmin() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Normalized User Document & Subcollections
    match /users/{userId} {
      allow read: if true; // Public access for student verification / authentication lookup
      allow create, update: if true;
      allow delete: if isAdmin();

      // Profile Subcollection
      match /profile/{docId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isAdmin();
      }

      // Dedicated Class Schedule Subcollection (Admin Managed)
      match /classSchedule/{docId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      // Settings Subcollection
      match /settings/{docId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isAdmin();
      }

      // Downloads Subcollection
      match /downloads/{docId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isAdmin();
      }
    }

    // Legacy Students collection backward-compatible rules
    match /students/{studentId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Sessions collection
    match /sessions/{sessionId} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Audit logs collection (Immutable trail)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // Downloads collection
    match /downloads/{downloadId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Announcements collection
    match /announcements/{annId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Schedules collection (Global Shared Schedules)
    match /schedules/{scheduleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
